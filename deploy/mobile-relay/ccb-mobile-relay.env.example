# CCB Mobile production relay environment template.
# Do not put raw invitations, device tokens, service-account files, or CCB
# project data in this file.

PYTHONPATH=/opt/ccb-source/lib
CCB_RELAY_LISTEN=127.0.0.1:18444
CCB_RELAY_PUBLIC_ORIGIN=wss://relay.seemlab.top
CCB_RELAY_STATE_DIR=/var/lib/ccb-mobile-relay
CCB_RELAY_ADMISSION_DB=/var/lib/ccb-mobile-relay/relay-admission.sqlite3

# Deployment-owned secret file. It must be mode 0600 and contain:
# {"verifier_key_b64":"...","capability_key_b64":"..."}
CCB_RELAY_ADMISSION_SECRETS=/etc/ccb/mobile-relay-admission-secrets.json

# The relay process terminates TLS itself when binding directly.
# If nginx terminates public TLS, keep this process on loopback with its own
# local TLS certificate or use explicit loopback-only test mode for local labs.
CCB_RELAY_TLS_CERT=/etc/ccb/mobile-relay-local.crt
CCB_RELAY_TLS_KEY=/etc/ccb/mobile-relay-local.key

CCB_RELAY_MAX_FRAME_BYTES=65536
CCB_RELAY_PEER_QUEUE_LIMIT=32
CCB_RELAY_WRITE_TIMEOUT_SECONDS=5
CCB_RELAY_HANDSHAKE_TIMEOUT_SECONDS=10
CCB_RELAY_IDLE_TIMEOUT_SECONDS=60
CCB_RELAY_HEARTBEAT_INTERVAL_SECONDS=20
CCB_RELAY_UNAUTH_RATE_LIMIT=30
CCB_RELAY_UNAUTH_RATE_LIMIT_WINDOW_SECONDS=60
